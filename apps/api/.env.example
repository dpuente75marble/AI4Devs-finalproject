# HTTP port (optional in local development; defaults to 3000).
# Railway injects PORT automatically — do not hardcode it in production.
# PORT=3000

# Comma-separated allowed browser origins for CORS (credentials: true).
# Omit or leave empty to use default local Vite dev ports (5173–5178).
# Production example:
# CORS_ORIGINS="https://deliveryops-ai.vercel.app"
# CORS_ORIGINS="http://localhost:5173,https://deliveryops-ai.vercel.app"
CORS_ORIGINS=

DATABASE_URL="postgresql://deliveryops:deliveryops@localhost:5433/deliveryops_ai?schema=public"
JWT_SECRET="change-me-in-local-dev"
JWT_EXPIRES_IN="30m"
AUTH_COOKIE_NAME="deliveryops_access_token"

# Local development (http://localhost)
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Production (Vercel frontend + Railway backend, cross-site HTTPS):
# AUTH_COOKIE_SECURE="true"
# AUTH_COOKIE_SAME_SITE="none"
# Note: SameSite=None requires Secure=true (browser requirement).
